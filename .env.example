# Database - Neon PostgreSQL
DATABASE_URL="postgresql://user:pass@host-pooler.region.neon.tech/db?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:pass@host.region.neon.tech/db?sslmode=require"

# NextAuth Configuration  
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# Payment Configuration
PAYMENT_GATEWAY="OFFLINE"    # or "ZARINPAL"
PUBLIC_APP_BASE="https://www.kiarakraft.com"  # Base URL used to build callback links
# Comma-separated host allowlist for selecting PUBLIC_APP_BASE (security)
# Example: "www.kiarakraft.com,kiarakraft.vercel.app"
ALLOWED_APP_BASE_HOSTS="www.kiarakraft.com"
# Stub secret for dev-only Zarinpal stub (never use in production gateways)
PAYMENT_STUB_SECRET="change-me-in-dev"

# Production Environment Variables
# NEXTAUTH_URL="https://your-domain.com"

# Image Upload - Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# AI Image Generation (OpenAI) — used by one-off product image generator
# Create a key at https://platform.openai.com/ and paste it here (sk-...)
OPENAI_API_KEY=""

# Optional: Future S3/R2 integration
# AWS_ACCESS_KEY_ID="your-aws-access-key"
# AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="your-bucket-name"

# Email Configuration - Resend (recommended) or SMTP
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="noreply@kiarakraft.com"
CONTACT_RECIPIENT="info@kiarakraft.com" # Recipient for contact form submissions

# Alternative: SMTP Configuration (if not using Resend)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"

# Analytics & Monitoring
# Plausible (recommended): set your domain to enable the script
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="kiarakraft.com"
# If you prefer Google Analytics instead, uncomment GA and remove Plausible env
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Sentry Error Tracking & Performance Monitoring
SENTRY_DSN="your-sentry-dsn"
SENTRY_ORG="your-sentry-org"
SENTRY_PROJECT="your-sentry-project"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"
# Environment for Sentry (development, staging, production)
SENTRY_ENVIRONMENT="development"

# Translation (Azure Translator)
# Required to enable automatic FA→EN product translations
# Get these from Azure AI Translator resource
# AZURE_TRANSLATOR_ENDPOINT="https://<your-translator>.cognitiveservices.azure.com"
# AZURE_TRANSLATOR_KEY=""
# AZURE_TRANSLATOR_REGION="eastus"

# Optional: Daily translation character budget (default 1,000,000)
# TRANSLATOR_DAILY_CHAR_LIMIT="1000000"

# Optional: Moderation signal (Azure AI Language/Content Safety)
# AZURE_AI_ENDPOINT="https://<your-language-or-contentsafety>.cognitiveservices.azure.com"
# AZURE_AI_KEY=""

# Notes:
# - To run search smoke test (S4), ensure DATABASE_URL/DIRECT_URL are valid and then:
#   npm run search:smoke