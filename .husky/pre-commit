#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Secrets detection
echo "🔍 Checking for secrets..."
git diff --cached --name-only -z | while IFS= read -r -d '' file; do
  if [ -f "$file" ]; then
    # Check for common secret patterns
    if grep -E "(sk-[A-Za-z0-9]{48}|AKIA[0-9A-Z]{16}|ghp_[0-9a-zA-Z]{36}|api[_-]?key\s*=\s*['\"][A-Za-z0-9_\-]{20,}|secret\s*=\s*['\"][A-Za-z0-9_\-]{20,})" "$file" 2>/dev/null; then
      echo "❌ Potential secret found in: $file"
      echo "💡 Use environment variables instead"
      exit 1
    fi
  fi
done

# Run existing lint-staged
npx lint-staged
