{
  "name": "kiarakraft",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "node scripts/dev/run.mjs dev",
    "test": "node scripts/dev/run.mjs test",
    "test:i18n": "node scripts/dev/run.mjs i18n",
    "test:application": "node test/application.http.test.mjs",
    "test:password-security": "node --import tsx test/password-security.http.test.ts",
    "build": "node scripts/dev/run.mjs build",
    "vercel-build": "node scripts/staging/build.mjs",
    "start": "next start",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint app components lib middleware.ts types --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=false eslint --fix . && prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "check:status": "tsx scripts/check-status.ts",
    "check:analytics": "tsx scripts/check-analytics.ts",
    "db:seed": "node scripts/dev/prepare-database.mjs dev",
    "db:seed:production": "tsx prisma/seed-production.ts",
    "db:seed:v3s1": "tsx scripts/seed-v3s1-sample.ts",
    "db:reset": "node --import tsx scripts/guard-reset.ts",
    "check:ssr": "tsx scripts/check-ssr.ts",
    "verify:i18n": "node scripts/dev/verify-locales.mjs",
    "verify:i18n:quick": "node scripts/quick-i18n-check.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "translate:backfill": "tsx scripts/backfill-translations.ts",
    "eligibility:backfill": "tsx scripts/backfill-eligibility.ts",
    "search:smoke": "tsx scripts/search-smoke.ts",
    "prisma:baseline:clear": "tsx scripts/prisma-reset-migrations-table.ts",
    "prisma:baseline:resolve": "prisma migrate resolve --applied 202508191343_init",
    "prisma:baseline:status": "prisma migrate status",
    "images:generate:products": "tsx scripts/generate-product-images.ts",
    "images:generate:products:missing": "tsx scripts/generate-product-images.ts --only-missing",
    "images:generate:products:replace": "tsx scripts/generate-product-images.ts --replace",
    "images:generate:categories": "tsx scripts/generate-category-images.ts",
    "images:fill:curated": "tsx scripts/fill-images-with-curated-urls.ts",
    "images:replace:curated-cloudinary": "tsx scripts/replace-images-with-curated-cloudinary.ts",
    "images:upload:categories:curated": "tsx scripts/upload-category-images-curated.ts",
    "lhci": "node scripts/dev/disabled-performance.mjs",
    "moderation:approve:all": "tsx scripts/approve-products.ts --all --status=APPROVED",
    "moderation:approve:id": "tsx scripts/approve-products.ts --id=ID --status=APPROVED",
    "moderation:approve:slug": "tsx scripts/approve-products.ts --slug=SLUG --status=APPROVED",
    "setup": "node scripts/dev/setup.mjs",
    "dev:local": "node scripts/dev/run.mjs dev",
    "start:local": "node scripts/dev/run.mjs start",
    "build:local": "node scripts/dev/run.mjs build",
    "test:tooling": "node --test test/tooling/*.test.mjs",
    "test:integration": "node scripts/dev/integration.mjs",
    "db:local:start": "node scripts/dev/local-db.mjs start",
    "db:local:stop": "node scripts/dev/local-db.mjs stop",
    "db:test:prepare": "node scripts/dev/prepare-database.mjs test",
    "security:secrets": "node scripts/security/scan-secrets.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run test:tooling && npm run verify:i18n",
    "worktree:new": "node scripts/dev/worktree.mjs",
    "test:legacy:moderation": "node scripts/dev/run.mjs legacy-moderation"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-email/render": "2.2.0",
    "@sentry/nextjs": "11.11.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node-fetch": "^2.6.13",
    "@types/sanitize-html": "^2.16.0",
    "@types/web-push": "^3.6.4",
    "@vercel/analytics": "^1.5.0",
    "@vercel/functions": "^3.3.4",
    "@vercel/speed-insights": "^1.3.1",
    "bcryptjs": "3.0.2",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.562.0",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.9.2",
    "node-fetch": "^3.3.2",
    "openai": "^6.7.0",
    "pg": "^8.16.3",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-hook-form": "^7.65.0",
    "resend": "6.12.3",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "smtp-mailer": "npm:nodemailer@10.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "undici": "7.30.2",
    "validator": "^13.15.22",
    "web-push": "^3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.41.0",
    "dotenv": "^17.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8",
    "prettier": "^3.7.4",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.16",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "bash -c 'ESLINT_USE_FLAT_CONFIG=false eslint --fix \"$@\"' _",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
