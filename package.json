{
  "name": "kiarakraft",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "node scripts/dev/run.mjs dev",
    "test": "node scripts/dev/run.mjs test",
    "test:i18n": "node scripts/dev/run.mjs i18n",
    "test:application": "node test/application.http.test.mjs",
    "test:password-security": "node --import tsx test/password-security.http.test.ts",
    "build": "node scripts/dev/run.mjs build",
    "vercel-build": "node scripts/staging/build.mjs",
    "start": "next start",
    "lint": "eslint app components lib middleware.ts types",
    "lint:fix": "eslint --fix \"**/*.{js,jsx,ts,tsx}\" && prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "check:status": "tsx scripts/check-status.ts",
    "check:analytics": "tsx scripts/check-analytics.ts",
    "db:seed": "node scripts/dev/prepare-database.mjs dev",
    "check:ssr": "tsx scripts/check-ssr.ts",
    "verify:i18n": "node scripts/dev/verify-locales.mjs",
    "verify:i18n:quick": "node scripts/quick-i18n-check.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "search:smoke": "tsx scripts/search-smoke.ts",
    "prisma:baseline:status": "prisma migrate status",
    "lhci": "node scripts/dev/disabled-performance.mjs",
    "setup": "node scripts/dev/setup.mjs",
    "dev:local": "node scripts/dev/run.mjs dev",
    "start:local": "node scripts/dev/run.mjs start",
    "build:local": "node scripts/dev/run.mjs build",
    "test:tooling": "node --test test/tooling/*.test.mjs",
    "test:integration": "node scripts/dev/integration.mjs",
    "db:local:start": "node scripts/dev/local-db.mjs start",
    "db:local:stop": "node scripts/dev/local-db.mjs stop",
    "db:test:prepare": "node scripts/dev/prepare-database.mjs test",
    "security:secrets": "node scripts/security/scan-secrets.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run test:tooling && npm run verify:i18n",
    "worktree:new": "node scripts/dev/worktree.mjs",
    "test:legacy:moderation": "node scripts/dev/run.mjs legacy-moderation"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-email/render": "2.2.0",
    "@sentry/nextjs": "11.11.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/sanitize-html": "^2.16.0",
    "@types/web-push": "^3.6.4",
    "@vercel/analytics": "^1.5.0",
    "@vercel/functions": "^3.3.4",
    "@vercel/speed-insights": "^1.3.1",
    "bcryptjs": "3.0.2",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.562.0",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.9.2",
    "node-fetch": "^3.3.2",
    "openai": "^6.7.0",
    "pg": "^8.16.3",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-hook-form": "^7.65.0",
    "resend": "6.12.3",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "smtp-mailer": "npm:nodemailer@10.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "undici": "7.30.2",
    "validator": "^13.15.22",
    "web-push": "^3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "dotenv": "^17.2.3",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8",
    "prettier": "^3.7.4",
    "prisma": "7.10.1",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@prisma/config@7.10.1": {
      "effect": "3.22.1"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
