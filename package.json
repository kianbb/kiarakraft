{
  "name": "kiarakraft",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "next dev",
    "test": "tsx test/chooseLocale.test.ts && tsx test/admin.verifySeller.test.ts && tsx test/search.partial.test.ts",
    "test:i18n": "tsx test/i18n.smoke.test.ts",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint app components lib middleware.ts types --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=false eslint --fix . && prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "check:status": "tsx scripts/check-status.ts",
    "check:analytics": "tsx scripts/check-analytics.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:production": "tsx prisma/seed-production.ts",
    "db:seed:v3s1": "tsx scripts/seed-v3s1-sample.ts",
    "db:reset": "tsx scripts/guard-reset.ts && prisma migrate reset --force && npm run db:seed",
    "check:ssr": "tsx scripts/check-ssr.ts",
    "verify:i18n": "node scripts/verify-i18n-complete.js",
    "verify:i18n:quick": "node scripts/quick-i18n-check.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "translate:backfill": "tsx scripts/backfill-translations.ts",
    "eligibility:backfill": "tsx scripts/backfill-eligibility.ts",
    "search:smoke": "tsx scripts/search-smoke.ts",
    "prisma:baseline:clear": "tsx scripts/prisma-reset-migrations-table.ts",
    "prisma:baseline:resolve": "prisma migrate resolve --applied 202508191343_init",
    "prisma:baseline:status": "prisma migrate status && prisma migrate deploy",
    "images:generate:products": "tsx scripts/generate-product-images.ts",
    "images:generate:products:missing": "tsx scripts/generate-product-images.ts --only-missing",
    "images:generate:products:replace": "tsx scripts/generate-product-images.ts --replace",
    "images:generate:categories": "tsx scripts/generate-category-images.ts",
    "images:fill:curated": "tsx scripts/fill-images-with-curated-urls.ts",
    "images:replace:curated-cloudinary": "tsx scripts/replace-images-with-curated-cloudinary.ts",
    "images:upload:categories:curated": "tsx scripts/upload-category-images-curated.ts",
    "lhci": "lhci autorun --upload.target=temporary-public-storage",
    "moderation:approve:all": "tsx scripts/approve-products.ts --all --status=APPROVED",
    "moderation:approve:id": "tsx scripts/approve-products.ts --id=ID --status=APPROVED",
    "moderation:approve:slug": "tsx scripts/approve-products.ts --slug=SLUG --status=APPROVED"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.2",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.18.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-email/render": "^1.2.3",
    "@sentry/nextjs": "^10.22.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node-fetch": "^2.6.13",
    "@types/nodemailer": "^7.0.0",
    "@types/web-push": "^3.6.4",
    "@vercel/analytics": "^1.5.0",
    "@vercel/functions": "^3.1.0",
    "@vercel/speed-insights": "^1.2.0",
    "bcryptjs": "3.0.2",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.6",
    "isomorphic-dompurify": "^2.30.1",
    "lucide-react": "^0.548.0",
    "next": "16.0.0",
    "next-auth": "5.0.0-beta.29",
    "next-intl": "^4.4.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.5",
    "openai": "^6.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "resend": "^6.1.0",
    "sharp": "^0.34.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "undici": "7.16.0",
    "validator": "^13.15.15",
    "web-push": "^3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.41.0",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "lint-staged": "^16.2.6",
    "pg": "^8.16.3",
    "postcss": "^8",
    "prettier": "^3.6.2",
    "prisma": "^6.18.0",
    "tailwindcss": "^4.1.16",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vercel": "^48.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
