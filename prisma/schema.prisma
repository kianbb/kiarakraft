generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String
  name                String?
  role                String               @default("BUYER")
  image               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  passwordChangedAt   DateTime?            // Track when password was last changed for session invalidation
  cart                Cart?
  orders              Order[]
  addresses           Address[]
  passwordResetTokens PasswordResetToken[]
  reviews             Review[]
  wishlistItems       WishlistItem[]
  pushSubscriptions   PushSubscription[]
  notificationLogs    NotificationLog[]
  returnRequests      ReturnRequest[]
  sellerProfile       SellerProfile?
}

model SellerProfile {
  id                String           @id @default(cuid())
  userId            String           @unique
  handle            String           @unique
  shopName          String
  displayName       String
  bio               String?          @db.Text
  region            String?
  avatarUrl         String?
  bannerUrl         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  phone             String?
  address           String?
  website           String?
  city              String?
  docsFolder        String?
  nationalIdHash    String?
  province          String?
  verificationNotes String?
  verified          Boolean          @default(false)
  verifiedAt        DateTime?
  verifiedBy        String?
  products          Product[]
  documents         SellerDocument[]
  user              User             @relation(fields: [userId], references: [id])

  @@index([shopName(ops: raw("gin_trgm_ops"))], map: "seller_shop_trgm_idx", type: Gin)
  @@index([handle])
}

model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  products Product[]

  @@index([name(ops: raw("gin_trgm_ops"))], map: "category_name_trgm_idx", type: Gin)
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Product {
  id                    String               @id @default(cuid())
  sellerId              String
  categoryId            String?
  title                 String
  slug                  String               @unique
  description           String
  priceToman            Int
  stock                 Int                  @default(0)
  active                Boolean              @default(true)
  isTest                Boolean              @default(false) // Marks internal/demo products that must be hidden from public listings
  ratingAvg             Float                @default(0)
  ratingCount           Int                  @default(0)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  eligibilityConfidence Int?
  eligibilityReasons    String?
  eligibilityStatus     String               @default("PENDING")
  cartItems             CartItem[]
  images                ListingImage[]
  orderItems            OrderItem[]
  wishlistItems         WishlistItem[]
  category              Category?            @relation(fields: [categoryId], references: [id])
  seller                SellerProfile        @relation(fields: [sellerId], references: [id])
  translations          ProductTranslation[]
  reviews               Review[]

  @@index([description(ops: raw("gin_trgm_ops"))], map: "product_desc_trgm_idx", type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], map: "product_title_trgm_idx", type: Gin)
}

model ProductTranslation {
  id          String   @id @default(cuid())
  productId   String
  locale      String
  title       String
  description String
  sourceHash  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id])

  @@unique([productId, locale])
}

model ListingImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  quantity  Int     @default(1)
  cart      Cart    @relation(fields: [cartId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

model Order {
  id             String          @id @default(cuid())
  userId         String
  addressId      String
  status         String          @default("PENDING")
  totalToman     Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id])
  address        Address         @relation(fields: [addressId], references: [id])
  items          OrderItem[]
  payment        Payment?
  shipping       OrderShipping?
  returnRequests ReturnRequest[]
}

model Payment {
  id          String         @id @default(cuid())
  orderId     String         @unique
  gateway     PaymentGateway
  status      PaymentStatus  @default(INITIATED)
  amountToman Int
  authority   String?
  refId       String?
  raw         Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  order       Order          @relation(fields: [orderId], references: [id])
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  productId      String
  unitPriceToman Int
  quantity       Int
  order          Order           @relation(fields: [orderId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  returnRequest  ReturnRequest?
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  fullName  String
  phone     String
  country   String
  province  String
  city      String
  line1     String
  line2     String?
  postal    String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  orders    Order[]
}

enum ShippingMethod {
  STANDARD
  EXPRESS
  PICKUP
}

model OrderShipping {
  id          String         @id @default(cuid())
  orderId     String         @unique
  method      ShippingMethod
  priceToman  Int
  trackingNo  String?
  status      String         @default("PROCESSING") // PROCESSING, SHIPPED, DELIVERED, RETURNED
  history     Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  order       Order          @relation(fields: [orderId], references: [id])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  userId     String
  rating     Int      @db.SmallInt
  title      String?
  body       String?  @db.Text
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@index([productId, status])
  @@unique([productId, userId]) // one review per buyer per product
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SellerDocument {
  id        String        @id @default(cuid())
  sellerId  String
  publicId  String
  url       String
  mime      String
  bytes     Int
  createdAt DateTime      @default(now())
  seller    SellerProfile @relation(fields: [sellerId], references: [id])

  @@index([sellerId])
}

enum PaymentStatus {
  INITIATED
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentGateway {
  OFFLINE
  ZARINPAL
  IDPAY
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model PushSubscription {
  id       String   @id @default(cuid())
  userId   String
  endpoint String   @unique
  p256dh   String
  auth     String
  createdAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationLog {
  id        String   @id @default(cuid())
  userId    String?
  type      String   // order_paid, order_shipped, order_delivered, review_approved
  channel   String   // email, push
  status    String   // sent, failed, pending
  data      Json?    // notification context data
  error     String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([createdAt])
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

model ReturnRequest {
  id          String       @id @default(cuid())
  orderId     String
  orderItemId String
  userId      String
  reason      String?      @db.Text
  status      ReturnStatus @default(REQUESTED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  order       Order        @relation(fields: [orderId], references: [id])
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  
  @@index([orderId])
  @@index([userId])
  @@unique([orderItemId])
}

model RateLimit {
  id         String   @id @default(cuid())
  identifier String   // IP:endpoint or email:type
  count      Int      @default(1)
  resetTime  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier])
  @@index([identifier, resetTime])
  @@index([resetTime]) // For cleanup queries
}

model FxRate {
  id        String   @id @default(cuid())
  base      String   // IRR
  counter   String   // USD, EUR
  rate      Float
  fetchedAt DateTime @default(now())

  @@unique([base, counter])
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String   // Audit action type
  userId       String?  // User who performed the action
  userEmail    String?  // User email for quick reference
  userRole     String?  // User role at time of action
  targetId     String?  // ID of affected resource
  targetType   String?  // Type of affected resource
  metadata     Json?    // Additional context data
  ipAddress    String?  // IP address of request
  userAgent    String?  // User agent string
  success      Boolean  // Whether action succeeded
  errorMessage String?  // Error message if failed
  timestamp    DateTime @default(now())
  signature    String?  // HMAC signature for integrity verification

  @@index([userId])
  @@index([action])
  @@index([targetId])
  @@index([timestamp])
  @@index([ipAddress])
}
